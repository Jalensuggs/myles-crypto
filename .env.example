# 设为 true 时使用本地模拟数据，不访问外网（界面会显示"模拟数据"标记）
VITE_USE_MOCK_DATA=false

# 以下都有默认值，只在需要走代理或镜像时覆盖
# VITE_BINANCE_FUTURES_REST=https://fapi.binance.com
# VITE_BINANCE_SPOT_REST=https://data-api.binance.vision
# VITE_BINANCE_FUTURES_WS=wss://fstream.binance.com/market/stream
# VITE_BINANCE_SPOT_WS=wss://data-stream.binance.vision/stream

# 美股官方历史 K 线的转发地址前缀。本机开发时由开发服务器自动转发，不用改。
# 部署到线上时要在服务器上配同样的转发规则（见 README）。设为 off 表示不用官方历史，只用合约数据。
# VITE_STOCK_HISTORY_BASE=/yahoo
